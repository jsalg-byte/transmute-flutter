# Public build-time configuration. Set these in Coolify's Environment Variables
# section; they are intentionally not secrets.
TRANSMUTE_REPOSITORY_MODE=api
TRANSMUTE_API_BASE_URL=https://api.transmute.mzootfb.xyz

# Configure this hostname in Coolify's Domains for transmute-flutter field,
# not as a container environment variable.
COOLIFY_PUBLIC_DOMAIN=https://transmute2.mzootfb.xyz
